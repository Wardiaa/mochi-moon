{
  "type": "module",
  "name": "mochi-moon-desktop",
  "version": "1.0.0",
  "private": true,
  "main": "main.cjs",
  "description": "A cozy pixel-art task manager with Mochi Moon Café theme",
  "author": "Mochi Moon Team",

  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "electron": "electron .",
    "electron:dev": "concurrently -k \"npm run dev\" \"wait-on http://localhost:5173 && npm run electron\"",
    "electron:build": "npm run build && electron-builder",
    "dist": "electron-builder",
    "build:win": "npm run build && electron-builder --win --x64",
    "build:win-portable": "npm run build && electron-builder --win --x64 --dir",
    "build:win-nsis": "npm run build && electron-builder --win nsis"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.0.5",
    "@radix-ui/react-label": "^2.0.2",
    "@radix-ui/react-radio-group": "^1.1.3",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-toast": "^1.1.5",
    "@radix-ui/react-tooltip": "^1.0.7",
    "autoprefixer": "^10.4.16",
    "canvas-confetti": "^1.9.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.0.0",
    "framer-motion": "^10.16.16",
    "lucide-react": "^0.309.0",
    "postcss": "^8.4.32",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tailwind-merge": "^2.2.0",
    "tailwindcss": "^3.3.6",
    "wouter": "^2.10.0"
  },
  "devDependencies": {
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^20.10.5",
    "@types/react": "^18.2.45",
    "@types/react-dom": "^18.2.18",
    "@vitejs/plugin-react": "^4.2.1",
    "concurrently": "^8.2.2",
    "electron": "^28.1.0",
    "electron-builder": "^24.9.1",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5.3.3",
    "vite": "^5.0.8",
    "wait-on": "^7.0.1"
  },
  "build": {
    "appId": "com.mochimoon.tasks",
    "productName": "Mochi Moon Task Manager",
    "copyright": "Copyright © 2024 Mochi Moon",
    "directories": {
      "output": "release",
      "buildResources": "public"
    },
    "files": [
      "dist/**/*",
      "main.cjs",
      "preload.cjs",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "public/fonts/",
        "to": "fonts/",
        "filter": ["**/*"]
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "public/favicon.ico",
      "artifactName": "${productName}-${version}-setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Mochi Moon Task Manager",
      "uninstallDisplayName": "Mochi Moon Task Manager",
      "installerIcon": "public/favicon.ico",
      "uninstallerIcon": "public/favicon.ico",
      "license": "license.txt",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": true
    },
    "mac": {
      "target": "dmg",
      "category": "public.app-category.productivity",
      "icon": "public/favicon.icns"
    },
    "linux": {
      "target": "AppImage",
      "icon": "public/favicon.png",
      "category": "Utility"
    },
    "publish": null
  }
}